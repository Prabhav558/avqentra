# Copy to .env.local and fill in. Never commit real values.
# Everything here is optional: the site runs without it, and the contact form falls back to the founder's email address.

# Public address of the site (canonical links, sitemap, share images). Defaults to https://avqentra.in
NEXT_PUBLIC_SITE_URL=https://avqentra.in

# Search console ownership tags (optional). Paste the token only, not the whole meta tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Store contact messages in Supabase (Project Settings -> API). Server only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email the founders when a message arrives, through Resend (https://resend.com). Server only.
# RESEND_FROM must be an address on a domain you have verified in Resend.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Avqentra <notify@avqentra.in>
# Where notifications go. Defaults to founder@avqentra.in
CONTACT_NOTIFY_TO=founder@avqentra.in
